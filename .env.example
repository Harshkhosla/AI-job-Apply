# Backend
PORT=4000
DATABASE_URL="file:./prisma/dev.db"

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Leave blank to auto-pick a model your key can access.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Frontend (Vite proxies /api -> backend, so VITE_API_URL only needed if not using proxy)
VITE_API_URL=http://localhost:4000

# Optional: LinkedIn auth cookie (li_at) for scraping — use at your own risk re: ToS
LINKEDIN_LI_AT=

# Optional: ScraperAPI / proxy key for Indeed/LinkedIn
SCRAPER_API_KEY=
