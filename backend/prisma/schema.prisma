// Prisma schema for JobsAutomation
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  location      String?
  headline      String?
  summary       String?
  skills        String   // JSON array as string
  experience    String   // JSON
  education     String   // JSON
  projects      String?  // JSON [{name, description, url, stack[]}]
  certifications String? // JSON [{name, issuer, year, url}]
  languages     String?  // JSON [{name, proficiency}]
  links         String?  // JSON {github, linkedin, portfolio, twitter, stackoverflow, leetcode, medium}
  preferences   String?  // JSON (target roles, locations, comp, remote, etc.)
  personal      String?  // JSON (DOB, gender, race, veteran, disability — for EEO forms)
  workAuth      String?  // JSON {citizenOf, authorizedToWorkIn[], needsSponsorshipIn[], visaStatus}
  application   String?  // JSON {noticePeriod, currentSalary, expectedSalary, availability, references, coverLetterSnippet}
  baseResume    String?  // markdown/plain text master resume
  resumeFileUrl String?  // optional path to uploaded PDF
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Job {
  id              String   @id @default(cuid())
  source          String   // greenhouse | lever | ashby | linkedin | indeed
  sourceJobId     String   // upstream id
  url             String
  company         String
  title           String
  location        String?
  remote          Boolean  @default(false)
  employmentType  String?
  description     String   // raw text/HTML stripped
  salaryMin       Int?
  salaryMax       Int?
  currency        String?
  postedAt        DateTime?
  fetchedAt       DateTime @default(now())

  score           Float?
  scoreReason     String?  // JSON: {pros, cons, fitSummary}
  tailoredResume  String?
  outreach        String?  // JSON {subject, body, recruiter?}
  status          String   @default("new") // new | shortlisted | applied | rejected | hidden
  notes           String?
  applications    Application[]

  @@unique([source, sourceJobId])
  @@index([status])
  @@index([score])
}

model IngestionRun {
  id         String   @id @default(cuid())
  source     String
  query      String?
  count      Int      @default(0)
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?
}

// One row per application attempt for a given job.
// Lifecycle: draft -> preview -> submitted | failed | skipped
model Application {
  id              String   @id @default(cuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status          String   @default("draft")
  formSchema      String?  // JSON: raw fields parsed from the form
  fieldPlan       String?  // JSON: {fields: [{id, label, value, source, confidence}], unresolved: [...]}
  coverLetter     String?
  resumeUsed      String?  // path or marker (e.g. "profile.resumeFileUrl")
  payload         String?  // JSON the bot would send
  rawResponse     String?  // response from ATS submission
  confirmationId  String?
  errors          String?  // JSON list
  dryRun          Boolean  @default(true)
  createdAt       DateTime @default(now())
  submittedAt     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

// Global auto-apply settings (single-row table; we read findFirst())
model AutoApplySettings {
  id                  String   @id @default(cuid())
  enabled             Boolean  @default(false)
  dailyCap            Int      @default(10)
  appliedToday        Int      @default(0)
  lastCounterReset    DateTime @default(now())
  minScore            Int      @default(75)
  allowedSources      String   @default("greenhouse,lever,ashby") // CSV
  requireApproval     Boolean  @default(true) // must click Submit; no full auto
  // Cached Claude answers to ambiguous questions, keyed by "company::questionHash"
  qaCache             String?  // JSON dict
  updatedAt           DateTime @updatedAt
}
